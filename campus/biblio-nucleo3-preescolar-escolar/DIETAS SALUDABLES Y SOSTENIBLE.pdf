   xmp:CreatorTool="Adobe Photoshop CC 2017 (Macintosh)"
   xmp:CreateDate="2012-11-05T13:41:09.80"
   xmp:ModifyDate="2019-10-10T16:59:42+02:00"
   xmp:MetadataDate="2019-10-10T16:59:42+02:00"
   dc:format="image/jpeg"
   aux:SerialNumber="2010851"
   aux:LensInfo="240/10 700/10 28/10 28/10"
   aux:Lens="24.0-70.0 mm f/2.8"
   aux:LensID="147"
   aux:ImageNumber="21787"
   aux:ApproximateFocusDistance="150/100"
   photoshop:LegacyIPTCDigest="9BC3639F75CF4DC8C39B8E162FE2940A"
   photoshop:Category="ENV"
   photoshop:State="-"
   photoshop:Country="CHAD"
   photoshop:TransmissionReference="CDS344"
   photoshop:CaptionWriter="CDS/sk"
   photoshop:Credit="Â©FAO/Carl de Souza"
   photoshop:Source="FAO: photo-library@fao.org"
   photoshop:DateCreated="2012-11-05"
   photoshop:City="N'Djamena"
   photoshop:Headline="&amp;nbsp;"
   photoshop:Instructions="&amp;nbsp;"
   photoshop:ColorMode="4"
   photoshop:ICCProfile="Coated FOGRA39 (ISO 12647-2:2004)"
   xmpMM:DocumentID="adobe:docid:photoshop:4b972d65-2bfc-117d-9e45-e224c5fdb278"
   xmpMM:InstanceID="xmp.iid:00b15d15-cdd8-4135-a7cc-c6986a395b4b"
   xmpMM:OriginalDocumentID="F52942E79508A0AA31EF02F62904F706"
   Iptc4xmpCore:CountryCode="TCD">
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Africa</rdf:li>
     <rdf:li>Bell peppers</rdf:li>
     <rdf:li>Chad</rdf:li>
     <rdf:li>Desert Locust</rdf:li>
     <rdf:li>Hands</rdf:li>
     <rdf:li>Locusts</rdf:li>
     <rdf:li>Markets</rdf:li>
     <rdf:li>Pests</rdf:li>
     <rdf:li>Rural environment</rdf:li>
     <rdf:li>Shopping</rdf:li>
     <rdf:li>Vegetables: Vendors</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:creator>
    <rdf:Seq/>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24758_0344</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Â©FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">05 November 2012, Njemena, Chad - Vendors selling vegetables at the central market. ANLA, with support from FAO, is conducting control operations against populations of desert locusts. FAO has alerted Algeria, Libya, Mauritania and Morocco to to prepare for the likely arrival of desert locust swarms from the Sahel in West Africa in the coming weeks. Large locust populations can cause devastation to farmer's crops and to flora which is a source of food for cattle and camels, animals that nomadic people depend on for survival.&amp;#xA;&amp;#xA;FAO Project: OSRO/RAF/214 - Desert Locust Threat in the Sahel - 2012. Objectives: The general objective of this project is to contribute to preserve the agricultural production and the food security of concerned populations in Niger, Chad and beyond. The specific objective of this project is to contribute to control the current Desert Locust outbreak in the infested areas of Niger, Chad and in Mauritania.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <photoshop:SupplementalCategories>
    <rdf:Bag>
     <rdf:li>Nature</rdf:li>
     <rdf:li>Invasive species</rdf:li>
    </rdf:Bag>
   </photoshop:SupplementalCategories>
   <xmpMM:History>
    <rdf:Seq>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:E3ADD92D6227E211BBF78DB1952784D0"
      stEvt:when="2012-11-05T19:07:39+03:00"
      stEvt:softwareAgent="Adobe Photoshop CS5.1 Windows"
      stEvt:changed="/"/>
     <rdf:li
      stEvt:action="saved"
      stEvt:instanceID="xmp.iid:00b15d15-cdd8-4135-a7cc-c6986a395b4b"
      stEvt:when="2019-10-10T16:59:42+02:00"
      stEvt:softwareAgent="Adobe Photoshop CC 2017 (Macintosh)"
      stEvt:changed="/"/>
    </rdf:Seq>
   </xmpMM:History>
   <lr:hierarchicalSubject>
