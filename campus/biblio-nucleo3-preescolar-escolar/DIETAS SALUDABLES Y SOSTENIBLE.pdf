   <dc:subject>
    <rdf:Bag>
     <rdf:li>Africa</rdf:li>
     <rdf:li>Beaches</rdf:li>
     <rdf:li>Boats</rdf:li>
     <rdf:li>Coastal communities</rdf:li>
