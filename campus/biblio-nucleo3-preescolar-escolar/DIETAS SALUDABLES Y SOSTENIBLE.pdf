   <dc:subject>
    <rdf:Bag>
     <rdf:li>Viet Nam</rdf:li>
     <rdf:li>Asia</rdf:li>
     <rdf:li>Food</rdf:li>
     <rdf:li>Fruits</rdf:li>
     <rdf:li>Lunch</rdf:li>
     <rdf:li>Vegetables</rdf:li>
     <rdf:li>preparing</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">24770HN2_8855</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">FAO. Editorial use only. Photo credit must be given.</rdf:li>
    </rdf:Alt>
   </dc:rights>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">22 July 2013,  Nhan My, Viet Nam - Food being prepared on plates for lunch including jacque fruits at farmer Dang Ngoc Dung's home. Since 1990, Viet Nam has reduced hunger by more than 80 percent. Some of that progress comes from a revival of traditional family farming. After years of food shortages, low agricultural productivity and simmering unrest, in the early 1980s Viet Nam began to experiment with limited economic policy reforms. These culminated in 1986 with the official introduction of ?Doi Moi,? or ?Renovation?: wide-scale reforms that would drastically alter the economic landscape, by introducing elements of a market economy.</rdf:li>
    </rdf:Alt>
   </dc:description>
